{% comment %}
  Bundle Recommendations - "Complete the Look"
  Displays curated product bundles with total savings
  
  Accepts:
  - cart: {Object} Shopify cart object (required)
  - heading: {String} Section heading (default: "Complete the Look")
  
  Usage:
  {% render 'bundle-recommendation', cart: cart %}
  {% render 'bundle-recommendation', cart: cart, heading: "Build Your Set" %}
{% endcomment %}

{% assign bundle_heading = heading | default: 'Complete the Look' %}
{% assign bundle_products = '' | split: '' %}
{% assign bundle_found = false %}

{% comment %}
  Check if any cart items have bundle_products metafield
  Use the first product with bundles as the seed
{% endcomment %}
{% for item in cart.items %}
  {% if item.product.metafields.custom.bundle_products and bundle_found == false %}
    {% assign bundle_found = true %}
    {% assign cart_product_ids = cart.items | map: 'product_id' %}
    
    {% comment %} Get bundle products excluding items already in cart {% endcomment %}
    {% for bundle_product in item.product.metafields.custom.bundle_products.value %}
      {% unless cart_product_ids contains bundle_product.id %}
        {% assign bundle_products = bundle_products | push: bundle_product %}
      {% endunless %}
    {% endfor %}
    
    {% break %}
  {% endif %}
{% endfor %}

{% comment %} Calculate bundle total and savings {% endcomment %}
{% if bundle_products.size > 0 %}
  {% assign bundle_total = 0 %}
  {% assign bundle_compare_total = 0 %}
  
  {% for product in bundle_products %}
    {% assign bundle_total = bundle_total | plus: product.price %}
    {% if product.compare_at_price %}
      {% assign bundle_compare_total = bundle_compare_total | plus: product.compare_at_price %}
    {% else %}
      {% assign bundle_compare_total = bundle_compare_total | plus: product.price %}
    {% endif %}
  {% endfor %}
  
  {% assign bundle_savings = bundle_compare_total | minus: bundle_total %}
  
  <div class="cart-bundle cart-rec">
    <div class="cart-rec__header">
      <h3 class="cart-rec__heading">{{ bundle_heading }}</h3>
      {% if bundle_savings > 0 %}
        <span class="cart-rec__savings">Save {{ bundle_savings | money }}</span>
      {% endif %}
    </div>
    
    <div class="cart-rec__grid cart-rec__grid--scroll">
      {% for product in bundle_products %}
        {% render 'recommendation-product-card', product: product, show_badge: true %}
      {% endfor %}
    </div>
    
    <div class="cart-rec__footer">
      <div class="cart-rec__total">
        <span class="cart-rec__total-label">Bundle Total:</span>
        <div class="cart-rec__total-prices">
          {% if bundle_compare_total > bundle_total %}
            <span class="cart-rec__total-compare">{{ bundle_compare_total | money }}</span>
          {% endif %}
          <span class="cart-rec__total-value">{{ bundle_total | money }}</span>
        </div>
      </div>
      
      <button 
        type="button" 
        class="cart-rec__add-all"
        data-action="add-bundle"
        data-products="{{ bundle_products | map: 'selected_or_first_available_variant' | map: 'id' | join: ',' }}">
        Add All to Cart
      </button>
    </div>
  </div>
{% endif %}
