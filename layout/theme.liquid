<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <title>
      {{ page_title }}
      {% if current_page != 1 %}
        &ndash; Page {{ current_page }}
      {% endif %}
      {% unless page_title contains shop.name %}
        &ndash; {{ shop.name }}
      {% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">

    {{ content_for_header }}

    {% render 'theme-style-variables' %}
    {% render 'design-system-overrides' %}

    {%- comment -%} Core theme CSS - always loaded {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    
    {%- comment -%} Layout sections - always loaded {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'sections-layout.css' | asset_url }}">

    {%- comment -%} Template-specific CSS bundles {%- endcomment -%}
    {% case template.name %}
      {% when 'index' %}
        <link rel="stylesheet" href="{{ 'sections-homepage.css' | asset_url }}">
      {% when 'product' %}
        <link rel="stylesheet" href="{{ 'sections-product.css' | asset_url }}">
      {% when 'collection' %}
        <link rel="stylesheet" href="{{ 'sections-collection.css' | asset_url }}">
      {% when 'cart' %}
        <link rel="stylesheet" href="{{ 'sections-cart.css' | asset_url }}">
      {% when 'page' %}
        <link rel="stylesheet" href="{{ 'sections-content.css' | asset_url }}">
        {% if template.suffix == 'showrooms' or page.handle == 'showrooms' or page.handle == 'showroom' %}
          <link rel="stylesheet" href="{{ 'sections-showroom.css' | asset_url }}">
        {% endif %}
    {% endcase %}
  </head>

  <body class="template-{{ template.name }}">
    {% section 'header' %}

    <main role="main">
      {% if settings.show_global_breadcrumbs %}
        {% unless request.page_type == 'index' or request.page_type == 'cart' %}
          <div class="breadcrumbs-container">
            {% render 'breadcrumbs-bar' %}
          </div>
        {% endunless %}
      {% endif %}
      
      {% if page.handle == 'showrooms' %}
        {% section 'showroom' %}
      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    {% section 'footer' %}

    {% section 'cart-drawer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_footer }}
  </body>
</html>
