<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <title>
      {{ page_title }}
      {% if current_page != 1 %}
        &ndash; Page {{ current_page }}
      {% endif %}
      {% unless page_title contains shop.name %}
        &ndash; {{ shop.name }}
      {% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%} Preconnect to Shopify CDN for faster asset loading {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">

    {%- comment -%} Preload critical fonts for faster LCP {%- endcomment -%}
    {%- if settings.heading_font != blank -%}
      {%- assign heading_font_url = settings.heading_font | font_url -%}
      {%- if heading_font_url != blank and heading_font_url contains 'cdn.shopify.com' -%}
        {{ heading_font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
      {%- endif -%}
    {%- endif -%}
    {%- if settings.body_font != blank -%}
      {%- unless settings.heading_font != blank and settings.body_font.family == settings.heading_font.family -%}
        {%- assign body_font_url = settings.body_font | font_url -%}
        {%- if body_font_url != blank and body_font_url contains 'cdn.shopify.com' -%}
          {{ body_font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}

    {{ content_for_header }}

    {%- comment -%} Theme CSS custom properties (colors, fonts from settings) {%- endcomment -%}
    {% render 'theme-style-variables' %}
    {% render 'design-system-overrides' %}

    {%- comment -%} 
      CRITICAL CSS - Inlined for instant first paint
      Contains: reset, tokens, header, hero base styles
    {%- endcomment -%}
    {% render 'critical-css' %}

    {% if request.design_mode %}
      <link rel="stylesheet" href="{{ 'sections-list-collections.css' | asset_url }}">
      <link rel="stylesheet" href="{{ 'sections-showroom.css' | asset_url }}">
    {% endif %}

    {%- comment -%} 
      BASE CSS - Dawn-style foundation (global styles, utilities, reset)
      Loaded first as the foundation for all other styles
    {%- endcomment -%}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    {%- comment -%} 
      CORE CSS - theme.css loaded with high priority (preload)
      Contains essential base styles needed for first paint
    {%- endcomment -%}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}

    {%- comment -%} 
      LAYOUT CSS - Loaded synchronously (header/footer on every page)
      Cannot defer - causes FOUC on footer
    {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'sections-layout.css' | asset_url }}">

    {%- comment -%} 
      TEMPLATE CSS - Load synchronously to prevent FOUC
    {%- endcomment -%}
    {% case template.name %}
      {% when 'index' %}
        <link rel="stylesheet" href="{{ 'sections-homepage.css' | asset_url }}">
      {% when 'product' %}
        <link rel="stylesheet" href="{{ 'sections-product.css' | asset_url }}">
      {% when 'collection' %}
        <link rel="stylesheet" href="{{ 'sections-collection.css' | asset_url }}">
      {% when 'list-collections' %}
        <link rel="stylesheet" href="{{ 'sections-list-collections.css' | asset_url }}">
      {% when 'cart' %}
        <link rel="stylesheet" href="{{ 'sections-cart.css' | asset_url }}">
      {% when 'page' %}
        <link rel="stylesheet" href="{{ 'sections-content.css' | asset_url }}">
        {% if template.suffix == 'showrooms' or page.handle == 'showrooms' or page.handle == 'showroom' or page.handle == 'collections' %}
          <link rel="stylesheet" href="{{ 'sections-showroom.css' | asset_url }}">
        {% endif %}
      {% when 'blog', 'article' %}
        <link rel="stylesheet" href="{{ 'sections-blog.css' | asset_url }}">
      {% when 'search' %}
        <link rel="stylesheet" href="{{ 'sections-blog.css' | asset_url }}">
      {% when '404' %}
        <link rel="stylesheet" href="{{ 'sections-blog.css' | asset_url }}">
    {% endcase %}
  </head>

  <body class="template-{{ template.name }}" data-template="{{ template.name }}">
    <script>document.documentElement.classList.remove('no-js');</script>
    {% section 'header' %}

    <main role="main">
      {% if settings.show_global_breadcrumbs %}
        {% unless request.page_type == 'index' or request.page_type == 'cart' %}
          <div class="breadcrumbs-container">
            {% render 'breadcrumbs-bar' %}
          </div>
        {% endunless %}
      {% endif %}
      
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% section 'cart-drawer' %}

    {%- comment -%} Code-split JavaScript - Load only what's needed {%- endcomment -%}
    <script src="{{ 'header.js' | asset_url }}" defer></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    
    {% if template.name == 'product' %}
      <script src="{{ 'product-form.js' | asset_url }}" defer></script>
    {% endif %}
    
    {% if template.name == 'collection' or template.name == 'list-collections' or template.name == 'search' %}
      <script src="{{ 'collection-filters.js' | asset_url }}" defer></script>
    {% endif %}
    
    {%- comment -%} Legacy theme.js kept for backward compatibility {%- endcomment -%}
    {%- comment -%} <script src="{{ 'theme.js' | asset_url }}" defer></script> {%- endcomment -%}
    
    {{ content_for_footer }}
  </body>
</html>
