{% comment %}
  Main blog section - displays article grid with pagination
  Used in templates/blog.json
{% endcomment %}

<section class="blog-section">
  <div class="blog-container">
    {% if section.settings.show_heading and blog.title %}
      <div class="blog-header">
        <h1 class="intro-heading">{{ blog.title }}</h1>
      </div>
    {% endif %}

    {% if blog.articles_count > 0 %}
      <div class="blog-grid">
        {% paginate blog.articles by section.settings.posts_per_page %}
          {% for article in blog.articles %}
            <article class="blog-card">
              <a href="{{ article.url }}" class="blog-card__link">
                <div class="blog-card__image">
                  {% render 'responsive-image', image: article.image, width: 800, alt: article.title %}
                </div>

                <div class="blog-card__content">
                  {% if section.settings.show_date %}
                    <time class="blog-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{ article.published_at | date: '%B %d, %Y' }}
                    </time>
                  {% endif %}

                  <h3 class="blog-card__title">{{ article.title }}</h3>

                  {% if section.settings.show_excerpt and article.excerpt != blank %}
                    <div class="blog-card__excerpt">
                      {{ article.excerpt | strip_html | truncate: 120 }}
                    </div>
                  {% endif %}

                  {% if section.settings.show_author and article.author %}
                    <p class="blog-card__author">By {{ article.author }}</p>
                  {% endif %}
                </div>
              </a>
            </article>
          {% endfor %}

          {% if paginate.pages > 1 %}
            <div class="blog-pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="blog-pagination__link blog-pagination__link--prev">
                  <span>&larr; Previous</span>
                </a>
              {% endif %}

              <span class="blog-pagination__current">
                Page {{ paginate.current_page }} of {{ paginate.pages }}
              </span>

              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="blog-pagination__link blog-pagination__link--next">
                  <span>Next &rarr;</span>
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endpaginate %}
      </div>
    {% else %}
      <div class="blog-empty">
        <p class="intro-text">No articles yet.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show blog title",
      "default": true
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts per page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publication date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Main blog"
    }
  ]
}
{% endschema %}
