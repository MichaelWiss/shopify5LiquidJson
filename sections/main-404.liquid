{% comment %}
  Main 404 section - displays page not found message
  Used in templates/404.json
{% endcomment %}

<section class="error-section">
  <div class="error-container">
    <div class="error-content">
      {% if section.settings.heading != blank %}
        <h1 class="error-heading">{{ section.settings.heading }}</h1>
      {% else %}
        <h1 class="error-heading">Page not found</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="error-subheading">{{ section.settings.subheading }}</p>
      {% else %}
        <p class="error-subheading">The page you were looking for does not exist.</p>
      {% endif %}

      <div class="error-actions">
        <a href="{{ routes.root_url }}" class="btn">
          {{ section.settings.button_label | default: 'Continue shopping' }}
        </a>
        
        <a href="{{ routes.search_url }}" class="btn btn-secondary">
          Search our store
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main 404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "The page you were looking for does not exist."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Continue shopping"
    }
  ],
  "presets": [
    {
      "name": "Main 404"
    }
  ]
}
{% endschema %}
