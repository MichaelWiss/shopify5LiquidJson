<div class="collections-list-header">
  {% if section.settings.title != blank %}
    <h1>{{ section.settings.title }}</h1>
  {% endif %}
  {% if section.settings.description != blank %}
    <p>{{ section.settings.description }}</p>
  {% endif %}
</div>

<div class="collections-list-grid">
  {% for block in section.blocks %}
    <div class="collections-list-item" {{ block.shopify_attributes }}>
      <div class="collections-list-image-container">
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'collection-image-inner' }}
        {% endif %}
      </div>
      
      <div class="collections-list-content">
        {% if block.settings.eyebrow != blank %}
          <div class="collections-list-eyebrow">{{ block.settings.eyebrow }}</div>
        {% endif %}
        
        <h2 class="collections-list-title">{{ block.settings.title | default: 'Collection Title' }}</h2>
        
        {% if block.settings.description != blank %}
          <div class="collections-list-description">{{ block.settings.description }}</div>
        {% endif %}
        
        <a href="{{ block.settings.link | default: '#' }}" class="collections-list-link">
          {{ block.settings.link_text | default: 'View Collection' }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Collections List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Page Description"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "View Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections List",
      "blocks": [
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" }
      ]
    }
  ]
}
{% endschema %}
