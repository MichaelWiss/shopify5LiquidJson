{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

<section class="newsletter-signup">
  <div class="newsletter-signup__container">
    {% if section.settings.label != blank %}
      <div class="newsletter-signup__label">{{ section.settings.label }}</div>
    {% endif %}
    
    {% if section.settings.heading != blank %}
      <h2 class="newsletter-signup__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% render 'newsletter-form',
      section_id: section.id,
      placeholder: section.settings.placeholder,
      button_label: section.settings.button_label,
      success_message: section.settings.success_message
    %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "NEWSLETTER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Studio News & Updates"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your Email Address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SIGN UP"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing!"
    }
  ],
  "presets": [
    {
      "name": "Newsletter signup"
    }
  ]
}
{% endschema %}
