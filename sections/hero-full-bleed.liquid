<section class="hero">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 3200 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero-image', sizes: '100vw' }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-image placeholder-svg' }}
  {% endif %}
  <div class="hero-overlay"></div>
  {% if section.settings.heading != blank %}
    <h1 class="hero-title" {% if section.settings.enable_scroll_fade %}data-scroll-fade{% endif %}>{{ section.settings.heading }}</h1>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero full bleed",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Refinements"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_fade",
      "label": "Enable scroll fade effect",
      "default": true,
      "info": "Logo fades and moves as user scrolls"
    }
  ],
  "presets": [
    {
      "name": "Hero full bleed"
    }
  ]
}
{% endschema %}
