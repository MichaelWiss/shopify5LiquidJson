<div class="showroom-section">
  <div class="showroom-showcase">
    <div class="showroom-showcase__large">
      {% render 'responsive-image', image: section.settings.image_1, width: 1400, placeholder_type: 'lifestyle-1' %}
    </div>
    
    <div class="showroom-showcase__grid">
      <div class="showroom-showcase__medium">
        {% render 'responsive-image', image: section.settings.image_2, width: 700, placeholder_type: 'lifestyle-1' %}
      </div>
      <div class="showroom-showcase__medium">
        {% render 'responsive-image', image: section.settings.image_3, width: 700, placeholder_type: 'lifestyle-1' %}
      </div>
    </div>

    <div class="showroom-showcase__large">
      {% render 'responsive-image', image: section.settings.image_4, width: 1400, placeholder_type: 'lifestyle-1' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Showroom Showcase",
  "settings": [
    {
      "type": "header",
      "content": "Image 1 (Large Top)"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "header",
      "content": "Image 2 (Medium Left)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "header",
      "content": "Image 3 (Medium Right)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "header",
      "content": "Image 4 (Large Bottom)"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    }
  ],
  "presets": [
    {
      "name": "Showroom Showcase"
    }
  ]
}
{% endschema %}
