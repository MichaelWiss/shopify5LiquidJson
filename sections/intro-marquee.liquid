<section class="intro-section">
  {% if section.settings.section_label != blank %}
    <div class="intro-label">{{ section.settings.section_label }}</div>
  {% endif %}

  {% if section.settings.text != blank %}
    <p class="intro-text">{{ section.settings.text | escape | newline_to_br }}</p>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="products-section">
      <div class="products-marquee-wrapper">
        <div class="products-scroll" role="list">
          {% comment %}First set of products{% endcomment %}
          {% for block in section.blocks %}
            <a class="product-thumb" href="{{ block.settings.link | default: '#' | escape }}" {{ block.shopify_attributes }} role="listitem">
              <div class="product-thumb-image">
                {% render 'responsive-image', image: block.settings.image, width: 400, sizes: '140px', alt: block.settings.title, placeholder_type: 'product-1' %}
              </div>
              {% if block.settings.title != blank %}
                <div class="product-thumb-title">{{ block.settings.title }}</div>
              {% endif %}
              {% if block.settings.price_text != blank %}
                <div class="product-thumb-price">{{ block.settings.price_text }}</div>
              {% endif %}
            </a>
          {% endfor %}
          {% comment %}Duplicate products for seamless loop{% endcomment %}
          {% for block in section.blocks %}
            <a class="product-thumb" href="{{ block.settings.link | default: '#' | escape }}" aria-hidden="true" role="listitem">
              <div class="product-thumb-image">
                {% render 'responsive-image', image: block.settings.image, width: 400, sizes: '140px', alt: block.settings.title, placeholder_type: 'product-1' %}
              </div>
              {% if block.settings.title != blank %}
                <div class="product-thumb-title">{{ block.settings.title }}</div>
              {% endif %}
              {% if block.settings.price_text != blank %}
                <div class="product-thumb-price">{{ block.settings.price_text }}</div>
              {% endif %}
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Intro with marquee",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label",
      "default": "Our Approach"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Introducing Omilia — a family of wall and ceiling-mounted lamps that embody timeless craftsmanship. Each piece celebrates the natural character of stone and wood, designed to elevate the spaces we inhabit with subtle elegance and enduring warmth."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product marquee item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Floor Lamps"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price text",
          "default": "From $1,245"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Intro with marquee",
      "blocks": [
        { "type": "product", "settings": { "title": "Floor Lamps", "price_text": "From $1,245" } },
        { "type": "product", "settings": { "title": "Surface Mounts", "price_text": "From $875" } },
        { "type": "product", "settings": { "title": "Chandeliers", "price_text": "From $2,890" } },
        { "type": "product", "settings": { "title": "Table Lamps", "price_text": "From $625" } },
        { "type": "product", "settings": { "title": "Pendants", "price_text": "From $1,450" } },
        { "type": "product", "settings": { "title": "Sconces", "price_text": "From $780" } }
      ]
    }
  ]
}
{% endschema %}
