{% schema %}
{
  "name": "Product Split Feature",
  "tag": "section",
  "class": "section-product-split",
  "settings": [
    {
      "type": "header",
      "content": "Product Content"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product Source",
      "info": "Content will be pulled from this product unless overridden below."
    },
    {
      "type": "text",
      "id": "custom_label",
      "label": "Floating Label",
      "default": "Orb 4 Surface Mount",
      "info": "Appears top-left over the image."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A no-frills fixture that brings its spherical, hand-blown glass diffuser to the fore. Designed for spaces of every style and scale.</p>"
    },
    {
      "type": "header",
      "content": "Visuals"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image (Left)",
      "info": "Tall, portrait image recommended."
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Detail Image (Small)",
      "info": "Appears in the sticky sidebar. Defaults to product image."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F6F2EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#29241E"
    }
  ],
  "presets": [
    {
      "name": "Product Split Feature"
    }
  ]
}
{% endschema %}

{%- assign product = section.settings.product -%}
{%- assign hero_img = section.settings.hero_image -%}
{%- assign detail_img = section.settings.detail_image | default: product.featured_image -%}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | escape }};
    color: {{ section.settings.text_color | escape }};
    overflow: visible !important;
    position: relative;
    z-index: 1;
  }
</style>

<div class="psf-container">
  
  <!-- LEFT: Hero Image -->
  <div class="psf-hero-col">
    <div class="psf-label">
      {{ section.settings.custom_label | default: product.title }}
    </div>

    {%- render 'responsive-image', image: hero_img, width: 2000, class: 'psf-hero-img', id: 'psfParallaxImg', placeholder_type: 'lifestyle-1', placeholder_class: 'psf-hero-img' -%}
  </div>

  <!-- RIGHT: Sticky Content -->
  <div class="psf-content-col">
    <div class="psf-sticky-wrapper" id="psfStickyContent">
      
      <div class="psf-description">
        {{ section.settings.description }}
      </div>

      <a href="{{ product.url | default: '#' }}" class="psf-product-card">
        {% render 'responsive-image', image: detail_img, width: 600, class: 'psf-product-thumb', placeholder_type: 'product-1' %}
      </a>

      <div class="psf-meta">
        <h2 class="psf-title">{{ product.title | default: "Orb 4 Surface Mount" }}</h2>
        <div class="psf-price">
          {% if product.price_varies %}From {% endif %}
          {{ product.price | default: 30000 | money }}
        </div>
        <a href="{{ product.url | default: '#' }}" class="psf-btn">Shop</a>
      </div>

    </div>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var sectionId = {{ section.id | json }};
  var container = document.getElementById('shopify-section-' + sectionId);
  var parallaxImg = container.querySelector('#psfParallaxImg');
  var stickyContent = container.querySelector('#psfStickyContent');

  // 1. Intersection Observer for Fade-In
  // ---------------------------------------------------------
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    
    observer.observe(stickyContent);
  } else {
    // Fallback for older browsers
    stickyContent.classList.add('is-visible');
  }

  // 2. Parallax Logic
  // ---------------------------------------------------------
  function handleParallax() {
    // Disable on mobile to prevent jumpiness/layout thrashing
    if (window.innerWidth < 1024) {
      parallaxImg.style.transform = 'none';
      return;
    }

    var rect = container.getBoundingClientRect();
    var viewHeight = window.innerHeight;

    // Only calculate if section is in viewport
    if (rect.top < viewHeight && rect.bottom > 0) {
      // Determine scroll distance relative to section top
      // We use a factor of 0.15 for a subtle, premium feel
      var scrollDist = (window.scrollY - container.offsetTop);
      var moveY = scrollDist * 0.15;

      parallaxImg.style.transform = 'translateY(' + moveY + 'px) scale(1.05)';
    }
  }

  // Attach scroll listener with requestAnimationFrame for performance
  window.addEventListener('scroll', function() {
    window.requestAnimationFrame(handleParallax);
  });
});
</script>