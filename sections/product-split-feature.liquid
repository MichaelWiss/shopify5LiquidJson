{% schema %}
{
  "name": "Product Split Feature",
  "tag": "section",
  "class": "section-product-split",
  "settings": [
    {
      "type": "header",
      "content": "Product Content"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product Source",
      "info": "Content will be pulled from this product unless overridden below."
    },
    {
      "type": "text",
      "id": "custom_label",
      "label": "Floating Label",
      "default": "Orb 4 Surface Mount",
      "info": "Appears top-left over the image."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A no-frills fixture that brings its spherical, hand-blown glass diffuser to the fore. Designed for spaces of every style and scale.</p>"
    },
    {
      "type": "header",
      "content": "Visuals"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image (Left)",
      "info": "Tall, portrait image recommended."
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Detail Image (Small)",
      "info": "Appears in the sticky sidebar. Defaults to product image."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F6F2EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#29241E"
    }
  ],
  "presets": [
    {
      "name": "Product Split Feature"
    }
  ]
}
{% endschema %}

{%- assign product = section.settings.product -%}
{%- assign hero_img = section.settings.hero_image -%}
{%- assign detail_img = section.settings.detail_image | default: product.featured_image -%}

<style>
  /* 
     CRITICAL: We target the specific ID to ensure we override any 
     theme-level defaults that might break sticky scrolling.
  */
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    /* 
       Sticky Logic:
       The parent of a sticky element cannot have overflow: hidden.
       We ensure visibility here, and only hide overflow on the specific 
       image container (.psf-hero-media) below.
    */
    overflow: visible !important; 
    position: relative;
    z-index: 1;
  }

  /* Utilities */
  .psf-container {
    width: 100%;
    margin: 0 auto;
    /* Grid Setup */
    display: grid;
    grid-template-columns: 1fr;
    /* 'stretch' is default, but being explicit helps. 
       This ensures the Right Column is as tall as the Left Column. */
    align-items: stretch; 
  }

  /* 
     ------------------------------
     LEFT COLUMN (Hero)
     ------------------------------
  */
  .psf-hero-col {
    position: relative;
    width: 100%;
    /* Mobile height constraint */
    height: 60vh; 
    background-color: rgba(0,0,0,0.1);
    
    /* 
       This is where we crop the parallax image. 
       It is safe to use overflow: hidden here because the sticky element 
       is in a SIBLING container, not a child of this one.
    */
    overflow: hidden; 
  }

  .psf-hero-img {
    position: absolute;
    /* Start higher up to allow parallax movement down */
    top: -10%; 
    left: 0;
    width: 100%;
    height: 120%; /* 20% taller than container */
    object-fit: cover;
    object-position: center;
    will-change: transform;
    transition: transform 0.1s linear;
  }

  /* Floating Label */
  .psf-label {
    position: absolute;
    top: 30px;
    left: 30px;
    z-index: 2;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .psf-label::before {
    content: '';
    width: 8px;
    height: 8px;
    background-color: #FFFFFF;
    border-radius: 50%;
    display: block;
  }

  /* 
     ------------------------------
     RIGHT COLUMN (Sticky Context)
     ------------------------------
  */
  .psf-content-col {
    position: relative;
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centers content vertically if image is huge */
  }

  /* The element that moves and sticks */
  .psf-sticky-wrapper {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
    max-width: 420px;
    margin: 0 auto; /* Center in column */
    
    /* Initial State for Fade-In */
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .psf-sticky-wrapper.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* 
     ------------------------------
     DESKTOP LAYOUT (Sticky Active)
     ------------------------------
  */
  @media (min-width: 1024px) {
    .psf-container {
      /* 60% Left, 40% Right */
      grid-template-columns: 1.5fr 1fr;
      min-height: 100vh;
    }

    .psf-hero-col {
      height: auto; /* Fill grid height */
      min-height: 100vh;
    }

    .psf-content-col {
      padding: 80px 60px;
      /* Allow sticky child to move within this track */
      display: block; 
    }

    .psf-sticky-wrapper {
      /* STICKY MAGIC HAPPENS HERE */
      position: -webkit-sticky;
      position: sticky;
      /* Adjust this value based on your Theme's Header Height */
      top: 50px; 
      
      /* Center vertically relative to viewport height approx */
      margin-top: 10vh; 
    }
  }

  /* Elements */
  .psf-description {
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.85;
  }

  .psf-product-card {
    background-color: rgba(0,0,0,0.05); /* Subtle contrast */
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 350px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 2px;
  }

  .psf-product-thumb {
    width: 35%;
    height: auto;
    border-radius: 50%;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
  }

  .psf-product-card:hover .psf-product-thumb {
    transform: scale(1.08);
  }

  .psf-meta {
    border-top: 1px solid rgba(0,0,0,0.1);
    padding-top: 20px;
  }

  .psf-title {
    font-family: "Times New Roman", Times, serif; /* Or theme serif */
    font-size: 22px;
    font-weight: 400;
    margin: 0 0 8px 0;
  }

  .psf-price {
    font-size: 14px;
    opacity: 0.7;
    margin-bottom: 16px;
  }

  .psf-btn {
    display: inline-block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    color: currentColor;
    transition: opacity 0.2s;
  }
  .psf-btn:hover {
    opacity: 0.6;
  }

</style>

<div class="psf-container">
  
  <!-- LEFT: Hero Image -->
  <div class="psf-hero-col">
    <div class="psf-label">
      {{ section.settings.custom_label | default: product.title }}
    </div>

    {%- if hero_img != blank -%}
      {{ hero_img | image_url: width: 2000 | image_tag: class: 'psf-hero-img', id: 'psfParallaxImg', loading: 'lazy' }}
    {%- else -%}
      <!-- Fallback for Demo -->
      <img src="https://images.unsplash.com/photo-1618220179428-22790b461013?q=80&w=2000&auto=format&fit=crop" 
           class="psf-hero-img" 
           id="psfParallaxImg" 
           alt="Demo Hero"
           loading="lazy">
    {%- endif -%}
  </div>

  <!-- RIGHT: Sticky Content -->
  <div class="psf-content-col">
    <div class="psf-sticky-wrapper" id="psfStickyContent">
      
      <div class="psf-description">
        {{ section.settings.description }}
      </div>

      <a href="{{ product.url | default: '#' }}" class="psf-product-card">
        {%- if detail_img != blank -%}
          {{ detail_img | image_url: width: 600 | image_tag: class: 'psf-product-thumb', loading: 'lazy' }}
        {%- else -%}
           <!-- Fallback for Demo -->
           <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/45/A_small_cup_of_coffee.JPG/640px-A_small_cup_of_coffee.JPG" 
                class="psf-product-thumb" 
                alt="Demo Product"
                style="border-radius:50%;">
        {%- endif -%}
      </a>

      <div class="psf-meta">
        <h2 class="psf-title">{{ product.title | default: "Orb 4 Surface Mount" }}</h2>
        <div class="psf-price">
          {% if product.price_varies %}From {% endif %}
          {{ product.price | default: 30000 | money }}
        </div>
        <a href="{{ product.url | default: '#' }}" class="psf-btn">Shop</a>
      </div>

    </div>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var sectionId = '{{ section.id }}';
  var container = document.getElementById('shopify-section-' + sectionId);
  var parallaxImg = container.querySelector('#psfParallaxImg');
  var stickyContent = container.querySelector('#psfStickyContent');

  // 1. Intersection Observer for Fade-In
  // ---------------------------------------------------------
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    
    observer.observe(stickyContent);
  } else {
    // Fallback for older browsers
    stickyContent.classList.add('is-visible');
  }

  // 2. Parallax Logic
  // ---------------------------------------------------------
  function handleParallax() {
    // Disable on mobile to prevent jumpiness/layout thrashing
    if (window.innerWidth < 1024) {
      parallaxImg.style.transform = 'none';
      return;
    }

    var rect = container.getBoundingClientRect();
    var viewHeight = window.innerHeight;

    // Only calculate if section is in viewport
    if (rect.top < viewHeight && rect.bottom > 0) {
      // Determine scroll distance relative to section top
      // We use a factor of 0.15 for a subtle, premium feel
      var scrollDist = (window.scrollY - container.offsetTop);
      var moveY = scrollDist * 0.15;

      parallaxImg.style.transform = 'translateY(' + moveY + 'px) scale(1.05)';
    }
  }

  // Attach scroll listener with requestAnimationFrame for performance
  window.addEventListener('scroll', function() {
    window.requestAnimationFrame(handleParallax);
  });
});
</script>