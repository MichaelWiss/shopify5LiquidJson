{{ 'section-product-split-layout.css' | asset_url | stylesheet_tag }}

<div class="product-split-layout">
  <div class="product-split-layout__wrapper">
    <div class="product-split-layout__left">
      {% if section.settings.hero_image %}
        {{ section.settings.hero_image | image_url: width: 1600 | image_tag:
          loading: 'lazy',
          widths: '400, 800, 1200, 1600, 2000',
          sizes: '(max-width: 968px) 100vw, 66vw',
          alt: section.settings.hero_image.alt | default: 'Product'
        }}
      {% else %}
        <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #e8e4dc 0%, #d0cbc1 100%); display: flex; align-items: center; justify-content: center; color: #999; font-size: 14px;">
          Add Hero Image
        </div>
      {% endif %}
      {% if section.settings.show_label and section.settings.label_text != blank %}
        <div class="product-split-layout__label">
          <div class="product-split-layout__label-dot"></div>
          <span>{{ section.settings.label_text }}</span>
        </div>
      {% endif %}
    </div>
    
    <div class="product-split-layout__right">
      <div class="product-split-layout__sticky-content">
        {% for block in section.blocks %}
        {% case block.type %}
          {% when 'title' %}
            <div class="product-split-layout__title" {{ block.shopify_attributes }}>
              {{ block.settings.title }}
            </div>

          {% when 'price' %}
            <div class="product-split-layout__price" {{ block.shopify_attributes }}>
              {{ block.settings.price }}
            </div>

          {% when 'description' %}
            <div class="product-split-layout__description" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {% when 'visual' %}
            <div class="product-split-layout__visual" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: 'Product Visual'
                }}
              {% else %}
                <div class="product-split-layout__orb">
                  <div class="product-split-layout__orb-main"></div>
                  <div class="product-split-layout__orb-ring"></div>
                </div>
              {% endif %}
            </div>

          {% when 'link' %}
            <a href="{{ block.settings.url }}" class="product-split-layout__link" {{ block.shopify_attributes }}>
              {{ block.settings.text | default: "Shop" }}
            </a>

          {% when 'section_header' %}
             <div class="product-split-layout__section" {{ block.shopify_attributes }}>
                <h3 class="product-split-layout__section-title">{{ block.settings.heading }}</h3>
             </div>

          {% when 'spec_item' %}
            <div class="product-split-layout__spec-item" {{ block.shopify_attributes }}>
              <span class="product-split-layout__spec-label">{{ block.settings.label }}</span>
              <span class="product-split-layout__spec-value">{{ block.settings.value }}</span>
            </div>

          {% when 'content' %}
            <div class="product-split-layout__section" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="product-split-layout__section-title">{{ block.settings.heading }}</h3>
              {% endif %}
              {{ block.settings.content }}
            </div>

        {% endcase %}
      {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Split Layout",
  "tag": "section",
  "class": "product-split-section",
  "settings": [
    {
      "type": "header",
      "content": "Left Column (Hero)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Tall images work best (e.g., 1200 x 1600px)"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label overlay",
      "default": true
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "Orb 4 Surface Mount"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Orb 4 Surface Mount"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "price",
          "label": "Price Text",
          "default": "From $300.00"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "A no-frills fixture that brings its spherical, hand-blown glass diffuser to the fore."
        }
      ]
    },
    {
      "type": "visual",
      "name": "Product Visual",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty for default orb graphic"
        }
      ]
    },
    {
      "type": "link",
      "name": "Link / Button",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link Text",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    },
    {
      "type": "section_header",
      "name": "Section Header",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Specifications"
        }
      ]
    },
    {
      "type": "spec_item",
      "name": "Spec Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Diameter"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "4 inches"
        }
      ]
    },
    {
      "type": "content",
      "name": "Rich Text Content",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (Optional)"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add details here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Split Layout",
      "blocks": [
        {
          "type": "description"
        },
        {
          "type": "visual"
        },
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "link"
        },
        {
          "type": "section_header",
          "settings": {
            "heading": "Specifications"
          }
        },
        {
          "type": "spec_item",
          "settings": {
            "label": "Diameter",
            "value": "4 inches"
          }
        },
        {
          "type": "spec_item",
          "settings": {
            "label": "Material",
            "value": "Glass"
          }
        },
        {
          "type": "content",
          "settings": {
            "heading": "Details",
            "content": "<p>Made to order.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}