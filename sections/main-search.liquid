{% comment %}
  Main search section - displays search form and results
  Used in templates/search.json
{% endcomment %}

<section class="search-section">
  <div class="search-container">
    <div class="search-header">
      <h1 class="intro-heading">Search</h1>
      
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <input 
          type="search" 
          name="q" 
          value="{{ search.terms | escape }}"
          placeholder="Search products and articles..."
          class="search-input"
          aria-label="Search"
        >
        <button type="submit" class="search-submit">
          Search
        </button>
      </form>
    </div>

    {% if search.performed %}
      {% if search.results_count > 0 %}
        <div class="search-results">
          <p class="search-results-count">
            {{ search.results_count }} result{% if search.results_count > 1 %}s{% endif %} for "{{ search.terms }}"
          </p>

          <div class="search-grid">
            {% paginate search.results by section.settings.results_per_page %}
              {% for item in search.results %}
                {% case item.object_type %}
                  {% when 'product' %}
                    <div class="search-item search-item--product">
                      {% render 'product-card', product: item %}
                    </div>

                  {% when 'article' %}
                    <article class="search-item search-item--article">
                      <a href="{{ item.url }}" class="search-item__link">
                        <div class="search-item__image">
                          {% if item.image %}
                            {{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: item.title }}
                          {% else %}
                            {{ 'image' | placeholder_svg_tag }}
                          {% endif %}
                        </div>
                        
                        <div class="search-item__content">
                          <span class="search-item__type">Article</span>
                          <h3 class="search-item__title">{{ item.title }}</h3>
                          {% if item.excerpt != blank %}
                            <p class="search-item__excerpt">{{ item.excerpt | strip_html | truncate: 100 }}</p>
                          {% endif %}
                        </div>
                      </a>
                    </article>

                  {% when 'page' %}
                    <article class="search-item search-item--page">
                      <a href="{{ item.url }}" class="search-item__link">
                        <div class="search-item__content">
                          <span class="search-item__type">Page</span>
                          <h3 class="search-item__title">{{ item.title }}</h3>
                          {% if item.content != blank %}
                            <p class="search-item__excerpt">{{ item.content | strip_html | truncate: 100 }}</p>
                          {% endif %}
                        </div>
                      </a>
                    </article>
                {% endcase %}
              {% endfor %}

              {% if paginate.pages > 1 %}
                <div class="search-pagination">
                  {% if paginate.previous %}
                    <a href="{{ paginate.previous.url }}" class="search-pagination__link">
                      &larr; Previous
                    </a>
                  {% endif %}

                  <span class="search-pagination__current">
                    Page {{ paginate.current_page }} of {{ paginate.pages }}
                  </span>

                  {% if paginate.next %}
                    <a href="{{ paginate.next.url }}" class="search-pagination__link">
                      Next &rarr;
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            {% endpaginate %}
          </div>
        </div>
      {% else %}
        <div class="search-empty">
          <p class="intro-text">No results found for "{{ search.terms }}"</p>
          <p class="search-empty__suggestion">Try a different search term or browse our collections below.</p>
        </div>
      {% endif %}
    {% else %}
      <div class="search-empty">
        <p class="intro-text">Enter a search term to find products and articles.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 6,
      "max": 24,
      "step": 6,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Main search"
    }
  ]
}
{% endschema %}
