{% comment %}
  Main search section - displays search form and results
  Used in templates/search.json
{% endcomment %}

<section class="search-section">
  <div class="search-container">
    <div class="search-header">
      <h1 class="intro-heading">{{ 'search.title' | t }}</h1>
      
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <input 
          type="search" 
          name="q" 
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          class="search-input"
          aria-label="{{ 'search.title' | t }}"
        >
        <button type="submit" class="search-submit">
          {{ 'search.submit' | t }}
        </button>
      </form>
    </div>

    {% if search.performed %}
      {% if search.results_count > 0 %}
        <div class="search-results">
          <p class="search-results-count">
            {{ search.results_count }} result{% if search.results_count > 1 %}s{% endif %} for "{{ search.terms }}"
          </p>

          <div class="search-grid">
            {% paginate search.results by section.settings.results_per_page %}
              {% for item in search.results %}
                {% case item.object_type %}
                  {% when 'product' %}
                    <div class="search-item search-item--product">
                      {% render 'product-card', product: item %}
                    </div>

                  {% when 'article' %}
                    <article class="search-item search-item--article">
                      <a href="{{ item.url }}" class="search-item__link">
                        <div class="search-item__image">
                          {% render 'responsive-image', image: item.image, width: 400, alt: item.title %}
                        </div>
                        
                        <div class="search-item__content">
                          <span class="search-item__type">{{ 'search.type_article' | t }}</span>
                          <h3 class="search-item__title">{{ item.title }}</h3>
                          {% if item.excerpt != blank %}
                            <p class="search-item__excerpt">{{ item.excerpt | strip_html | truncate: 100 }}</p>
                          {% endif %}
                        </div>
                      </a>
                    </article>

                  {% when 'page' %}
                    <article class="search-item search-item--page">
                      <a href="{{ item.url }}" class="search-item__link">
                        <div class="search-item__content">
                          <span class="search-item__type">{{ 'search.type_page' | t }}</span>
                          <h3 class="search-item__title">{{ item.title }}</h3>
                          {% if item.content != blank %}
                            <p class="search-item__excerpt">{{ item.content | strip_html | truncate: 100 }}</p>
                          {% endif %}
                        </div>
                      </a>
                    </article>
                {% endcase %}
              {% endfor %}

              {% render 'pagination', paginate: paginate %}
            {% endpaginate %}
          </div>
        </div>
      {% else %}
        <div class="search-empty">
          <p class="intro-text">{{ 'search.no_results' | t: terms: search.terms }}</p>
          <p class="search-empty__suggestion">{{ 'search.no_results_suggestion' | t }}</p>
        </div>
      {% endif %}
    {% else %}
      <div class="search-empty">
        <p class="intro-text">{{ 'search.empty' | t }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 6,
      "max": 24,
      "step": 6,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Main search"
    }
  ]
}
{% endschema %}
