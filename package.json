{
  "name": "shopify5-liquid-json",
  "private": true,
  "scripts": {
    "build:theme": "sass --no-source-map theme.scss assets/theme.css",
    "build:layout": "sass --no-source-map sections-layout.scss assets/sections-layout.css",
    "build:homepage": "sass --no-source-map sections-homepage.scss assets/sections-homepage.css",
    "build:product": "sass --no-source-map sections-product.scss assets/sections-product.css",
    "build:collection": "sass --no-source-map sections-collection.scss assets/sections-collection.css",
    "build:cart": "sass --no-source-map sections-cart.scss assets/sections-cart.css",
    "build:content": "sass --no-source-map sections-content.scss assets/sections-content.css",
    "build:css": "npm run build:theme && npm run build:layout && npm run build:homepage && npm run build:product && npm run build:collection && npm run build:cart && npm run build:content",
    "watch:css": "sass --watch theme.scss:assets/theme.css sections-layout.scss:assets/sections-layout.css sections-homepage.scss:assets/sections-homepage.css sections-product.scss:assets/sections-product.css sections-collection.scss:assets/sections-collection.css sections-cart.scss:assets/sections-cart.css sections-content.scss:assets/sections-content.css",
    "lint:homepage": "node scripts/check-homepage-styles.js"
  },
  "devDependencies": {
    "sass": "^1.72.0"
  }
}
